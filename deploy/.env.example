# Kopieren nach deploy/.env und mit echten Werten fuellen. .env selbst ist
# in .gitignore -- landet nie im Repo.

# Starkes Secret, z.B. per: openssl rand -hex 32
DB_PASS=change-me

# Starkes Secret, z.B. per: openssl rand -hex 32
ADMIN_TOKEN=change-me

# Optional -- https://steamcommunity.com/dev/apikey. Leer lassen = kein
# Steam-Avatar-Sync (Name funktioniert trotzdem, braucht keinen Key).
STEAM_WEB_API_KEY=
